# Backend API base URL (no trailing slash). The browser talks ONLY to this
# backend - never directly to NWS/USGS/FIRMS/AirNow/Google, per section 35.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional: a BROWSER-RESTRICTED Google Maps Platform key (HTTP referrer
# restricted to your domain in the Google Cloud console - see section 44/40).
# Leave unset to use the built-in MapLibre/OpenStreetMap engine, which needs
# no key and is the default so the app works out of the box (section 46).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional Google Cloud map ID for cloud styling and Advanced Markers.
# Keep blank when using the open fallback map.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# OpenFreeMap is the default and requires no API key. Set both values below only
# to opt into MapTiler satellite/hybrid tiles with a valid referrer-restricted
# browser key. An orphaned key alone is deliberately ignored.
NEXT_PUBLIC_MAP_PROVIDER=openfreemap
NEXT_PUBLIC_MAPTILER_KEY=

# Workshop modules. New modules can be toggled independently; Genome Lab is off by default.
NEXT_PUBLIC_FF_LIVE_ROLLING=true
NEXT_PUBLIC_FF_HISTORIC_EVENTS=true
NEXT_PUBLIC_FF_GENOME_LAB=false
