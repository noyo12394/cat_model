# Backend API base URL (no trailing slash). The browser talks ONLY to this
# backend - never directly to NWS/USGS/FIRMS/AirNow/Google, per section 35.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional: a BROWSER-RESTRICTED Google Maps Platform key (HTTP referrer
# restricted to your domain in the Google Cloud console - see section 44/40).
# Leave unset to use the built-in MapLibre/OpenStreetMap engine, which needs
# no key and is the default so the app works out of the box (section 46).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
