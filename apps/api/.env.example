# Copy to .env and fill in what you have. Every value below is OPTIONAL -
# the API runs fully in demo mode with none of them set. See
# docs/DATA_SOURCE_CARDS.md for what each source needs and where to get a key.

ENVIRONMENT=local
CORS_ALLOW_ORIGINS=http://localhost:3000

# National Weather Service - no key required, override only for testing.
NWS_BASE_URL=https://api.weather.gov

# USGS Water Data - no key required.
USGS_WATER_BASE_URL=https://waterservices.usgs.gov/nwis

# USGS Earthquakes - no key required.
USGS_QUAKE_BASE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0

# GDACS global multi-hazard GeoJSON API - no key required.
GDACS_BASE_URL=https://www.gdacs.org/gdacsapi/api
LIVE_WINDOW_DAYS=90
GDACS_CACHE_TTL_SECONDS=600

# NASA FIRMS (active fire detections) - requires a registered MAP_KEY.
# https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=
NASA_FIRMS_MAP_KEY=

# Optional for ACS requests. Census coordinate geography lookup needs no key.
CENSUS_API_KEY=

# AirNow (air quality) - requires an API key.
# https://docs.airnowapi.org/
AIRNOW_API_KEY=

# OpenFEMA - no key required.
OPENFEMA_BASE_URL=https://www.fema.gov/api/open

# Optional: read-only X API posts used by the Community Signals tab. This is
# never exposed to the browser. Without it, the tab states that no verified
# social source is connected rather than inventing sentiment or reports.
# https://docs.x.com/x-api/posts/search-recent-posts
X_BEARER_TOKEN=

# Google Maps Platform - server-side key for Routes/Places proxying (never
# exposed to the browser). Restrict this key to server IPs in the Google
# Cloud console. The frontend uses a SEPARATE, browser-restricted key - see
# apps/web/.env.example.
GOOGLE_MAPS_SERVER_API_KEY=

# Storage - unset by default; the API runs on an in-memory demo repository
# with no database required. Set these when running the full docker-compose
# stack with Postgres/PostGIS + Redis.
DATABASE_URL=
REDIS_URL=

# Optional: Groq only rephrases an already-computed EarthPulse fact block.
# It never generates hazard facts, numbers, probabilities, or route safety.
# https://console.groq.com/docs/text-chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

RATE_LIMIT_PER_MINUTE=120
